@page "/"
@using CalculatorApp.Models
@using CalculatorApp.ViewModels
@inject CalculatorViewModel ViewModel

<PageTitle>Calculator</PageTitle>

<div class="Calculator">
    <div class="Calculator-Display">
        @ViewModel.DisplayText
    </div>
    <div class="Calculator-Keypad">
        <button @onclick="() => ViewModel.Clear()">C</button>

        <button @onclick="() => ViewModel.ApplyOperation(CalculatorOperation.Divide)">÷</button>
        <button @onclick="() => ViewModel.ApplyOperation(CalculatorOperation.Multiply)">×</button>
        <button @onclick="() => ViewModel.ApplyOperation(CalculatorOperation.Subtract)">−</button>

        <button @onclick="() => ViewModel.EnterDigit(7)">7</button>
        <button @onclick="() => ViewModel.EnterDigit(8)">8</button>
        <button @onclick="() => ViewModel.EnterDigit(9)">9</button>
        <button @onclick="() => ViewModel.ApplyOperation(CalculatorOperation.Add)">+</button>

        <button @onclick="() => ViewModel.EnterDigit(4)">4</button>
        <button @onclick="() => ViewModel.EnterDigit(5)">5</button>
        <button @onclick="() => ViewModel.EnterDigit(6)">6</button>

        <button @onclick="() => ViewModel.EnterDigit(1)">1</button>
        <button @onclick="() => ViewModel.EnterDigit(2)">2</button>
        <button @onclick="() => ViewModel.EnterDigit(3)">3</button>

        <button class="zero" @onclick="() => ViewModel.EnterDigit(0)">0</button>
        <button @onclick="() => ViewModel.EnterDecimal()">.</button>
        <button @onclick="() => ViewModel.Equals()">=</button>
    </div>
</div>